# Replace with reviewed hostname, TLS/DNS prerequisites, and validated app health checks.
{$APP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    reverse_proxy app:3000 {
        health_uri /health
        health_interval 15s
        health_timeout 3s
    }
    log {
        output stdout
        format json
    }
}
