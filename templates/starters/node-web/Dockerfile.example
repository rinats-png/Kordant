# Example only: verify and pin base image digest before production, scan with Trivy.
FROM node:22-alpine
WORKDIR /app
COPY --chown=10001:10001 package.json server.mjs ./
COPY --chown=10001:10001 public ./public
USER 10001:10001
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
EXPOSE 3000
CMD ["node", "server.mjs"]
