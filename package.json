    "docs/",
    "templates/",
    "infra/",
    "integrations/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "START_HIER.md",
    "prompts/",
    "scripts/",
    "integrations/"
  ],
  "dependencies": {}
}
