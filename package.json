{
  "name": "kordant",
  "version": "0.2.0",
  "description": "Local-first agentic product engineering orchestration, evidence gates and operational blueprints",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kordant": "./bin/kordant.mjs"
  },
  "scripts": {
