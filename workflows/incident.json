      "scope": [
        "docs/incident/"
      ],
      "dependsOn": [],
      "requiredEvidence": [
        "artifact",
        "review"
      ]
    },
    {
      "id": "contain",
      "title": "Sichere Eindämmungsoptionen mit Freigabe",
