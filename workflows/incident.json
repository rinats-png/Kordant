      "skill": "security-threat-model",
      "scope": [
        "docs/incident/"
      ],
      "dependsOn": [
        "triage"
      ],
      "requiredEvidence": [
        "artifact",
        "review"
      ]
    },
    {
      "id": "fix",
      "title": "Abgestimmten Fix isoliert umsetzen",
      "agent": "engineer",
      "skill": "implementation",
      "scope": [
        "src/"
      ],
      "dependsOn": [
        "contain"
      ],
      "requiredEvidence": [
        "test",
        "review"
      ]
    },
    {
      "id": "postmortem",
      "title": "Root Cause, Schutzmaßnahmen, Kommunikation",
      "agent": "reviewer",
      "skill": "incident-response",
      "scope": [
        "docs/incident/"
      ],
      "dependsOn": [
        "fix"
      ],
      "requiredEvidence": [
        "artifact",
        "review"
      ]
    }
